@page
@model WhenWorksWeb.Areas.Admin.Pages.Users.ManageUsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">Manage Users</h1>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<div class="row g-4">

    <!-- Current Admins Section -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title">Current Admins</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>User Name</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var admin in Model.AdminUsers)
                            {
                                <tr>
                                    <td>@admin.Email</td>
                                    <td>@admin.UserName</td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="RemoveAdmin" class="d-inline">
                                            <input type="hidden" name="email" value="@admin.Email" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Admin Section -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title">Add Admin</h2>
                <form method="post" asp-page-handler="AddAdmin" class="mt-3">
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Email">User Email</label>
                    </div>

                    <button type="submit" class="btn btn-primary">Add Admin</button>
                </form>
            </div>
        </div>
    </div>
</div>
