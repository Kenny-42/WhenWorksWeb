@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

@if (Model.HasError)
{
    <!-- Generic error page -- reached with no email to confirm, either directly or via a narrow
         post-sign-in re-lookup race (see RegisterConfirmation.cshtml.cs's HasError remarks). -->
    <div class="text-center mb-5">
        <h1 class="ww-hero-title font-display mb-4">SOMETHING WENT WRONG</h1>
        <div class="row justify-content-center">
            <div class="col-md-5 mx-auto">
                <div class="ww-account-card ww-account-card-yellow">
                    <p class="text-on-gradient fs-5 mb-3">
                        We couldn't tell which account to confirm. Please try signing in or
                        registering again.
                    </p>
                    <a id="back-to-login" class="text-on-gradient text-link fw-semibold" asp-page="./Login">Back to sign in</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Confirm email required page -->
    <div class="text-center mb-5">
        <h1 class="ww-hero-title font-display mb-4">CONFIRM YOUR EMAIL</h1>
        <div class="row justify-content-center">
            <div class="col-md-5 mx-auto">
                <div class="ww-account-card ww-account-card-yellow">
                    <p class="text-on-gradient fs-5 mb-3">
                        You must confirm your email before you can log in. Check
                        <strong>@Model.Email</strong> for a confirmation link.
                    </p>
                    <a id="resend-confirmation" class="text-on-gradient text-link fw-semibold" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                </div>
            </div>
        </div>
    </div>
}
