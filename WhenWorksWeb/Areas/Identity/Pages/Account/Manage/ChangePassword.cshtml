@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="h4 font-display text-on-gradient mb-2">@ViewData["Title"]</h2>
<hr class="account-divider w-100 mb-3" />
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="d-flex flex-column align-items-center gap-2">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <!-- Old password -->
    <div>
        <label asp-for="Input.OldPassword" class="text-on-gradient fw-bold mb-1 d-block">Old Password</label>
        <input asp-for="Input.OldPassword"
               class="form-control input-pill input-pill-blue mx-auto"
               style="width: 100%; max-width: 16rem;"
               autocomplete="new-password"
               aria-required="true"
               placeholder="password" />
        <span asp-validation-for="Input.OldPassword" class="text-danger d-block mt-1"></span>
    </div>

    <!-- New password -->
    <div>
        <label asp-for="Input.NewPassword" class="text-on-gradient fw-bold mb-1 d-block">New Password</label>
        <input asp-for="Input.NewPassword"
               class="form-control input-pill input-pill-red mx-auto"
               style="width: 100%; max-width: 16rem;"
               autocomplete="new-password"
               aria-required="true"
               placeholder="password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger d-block mt-1"></span>
    </div>

    <!-- Confirm new password -->
    <div>
        <label asp-for="Input.ConfirmPassword" class="text-on-gradient fw-bold mb-1 d-block">Confirm New Password</label>
        <input asp-for="Input.ConfirmPassword"
               class="form-control input-pill input-pill-red mx-auto"
               style="width: 100%; max-width: 16rem;"
               autocomplete="new-password"
               aria-required="true"
               placeholder="password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mt-1"></span>
    </div>

    <button type="submit" class="btn enter-button mt-3">UPDATE PASSWORD</button>

    <a id="forgot-password" class="text-on-gradient fw-semibold mt-2" asp-page="../ForgotPassword">Forgot your password?</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
