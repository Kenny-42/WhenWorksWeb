@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h2 class="h4 font-display text-on-gradient mb-2">@ViewData["Title"]</h2>
<hr class="account-divider w-100 mb-3" />
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" class="d-flex flex-column align-items-center gap-2">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

    <!-- Current email (read-only) -->
    <div class="text-center">
        <label asp-for="Email" class="text-on-gradient fw-bold mb-1 d-block">Old Email</label>
        <input asp-for="Email"
               class="form-control input-pill input-pill-yellow mx-auto"
               style="width: 100%; max-width: 16rem;"
               placeholder="Current email"
               disabled />
        @if (Model.IsEmailConfirmed)
        {
            <span class="text-on-gradient fw-bold d-block mt-1">&#10003; Confirmed</span>
        }
        else
        {
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link text-on-gradient fw-semibold p-0 mt-1">
                Send verification email
            </button>
        }
    </div>

    <!-- New email -->
    <div>
        <label asp-for="Input.NewEmail" class="text-on-gradient fw-bold mb-1 d-block">New Email</label>
        <input asp-for="Input.NewEmail"
               class="form-control input-pill input-pill-yellow mx-auto"
               style="width: 100%; max-width: 16rem;"
               autocomplete="off"
               aria-required="true"
               placeholder="example@mail.com" />
        <span asp-validation-for="Input.NewEmail" class="text-danger d-block mt-1"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn enter-button mt-3">CHANGE EMAIL</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
