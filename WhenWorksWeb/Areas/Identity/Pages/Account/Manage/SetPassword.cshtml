@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="h4 font-display text-on-gradient mb-2">@ViewData["Title"]</h2>
<hr class="account-divider w-100 mb-3" />
<partial name="_StatusMessage" for="StatusMessage" />

<p class="text-on-gradient text-center">
    You do not have a local username/password for this site. Add a local
    account so you can log in without an external login.
</p>

<form id="set-password-form" method="post" class="d-flex flex-column align-items-center gap-2">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <!-- New password -->
    <div>
        <label asp-for="Input.NewPassword" class="visually-hidden"></label>
        <input asp-for="Input.NewPassword"
               class="form-control input-pill input-pill-red mx-auto"
               style="width: 100%; max-width: 16rem;"
               autocomplete="new-password"
               placeholder="New password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger d-block mt-1"></span>
    </div>

    <!-- Confirm new password -->
    <div>
        <label asp-for="Input.ConfirmPassword" class="visually-hidden"></label>
        <input asp-for="Input.ConfirmPassword"
               class="form-control input-pill input-pill-red mx-auto"
               style="width: 100%; max-width: 16rem;"
               autocomplete="new-password"
               placeholder="Confirm new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mt-1"></span>
    </div>

    <button type="submit" class="btn enter-button mt-3"><span class="ww-shiny-text">SET PASSWORD</span></button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
