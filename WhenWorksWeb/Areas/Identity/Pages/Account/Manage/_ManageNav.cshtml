@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<!-- Sidebar nav for the Manage account pages: pill links matching the
     external-provider-button treatment from Login/Register, with the
     active page filled solid instead of outlined.

     External Logins isn't scaffolded yet (see the Account Manage
     scaffolding conversation) — its link is kept here anyway, matching
     the default Identity nav, and will 404 until it's scaffolded in a
     follow-up pass. Two-Factor Authentication was scaffolded in
     Spec/Features/FEATURES-two-factor-authentication.ospec. -->
<ul class="nav flex-column gap-2">
    <li class="nav-item">
        <a class="manage-nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index"><span class="ww-shiny-text">Profile</span></a>
    </li>
    <li class="nav-item">
        <a class="manage-nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email"><span class="ww-shiny-text">Email</span></a>
    </li>
    <li class="nav-item">
        <a class="manage-nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword"><span class="ww-shiny-text">Password</span></a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item">
            <a id="external-login" class="manage-nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins"><span class="ww-shiny-text">External logins</span></a>
        </li>
    }
    <li class="nav-item">
        <a class="manage-nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication"><span class="ww-shiny-text">Two-factor authentication</span></a>
    </li>
    <li class="nav-item">
        <a class="manage-nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData"><span class="ww-shiny-text">Personal data</span></a>
    </li>
</ul>
