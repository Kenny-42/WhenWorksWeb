@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h4 font-display text-on-gradient mb-2">@ViewData["Title"]</h2>
<hr class="account-divider w-100 mb-3" />

<div class="alert alert-warning" role="alert">
    <p class="mb-0">
        <strong>
            Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
            used in an authenticator app you should <a asp-page="./ResetAuthenticator">reset your authenticator keys.</a>
        </strong>
    </p>
</div>

<form method="post" class="d-flex align-items-center gap-2 justify-content-center">
    <a asp-page="./TwoFactorAuthentication" class="btn modal-cancel-button"><span class="ww-shiny-text">Cancel</span></a>
    <button class="btn modal-delete-button" type="submit"><span class="ww-shiny-text">GENERATE NEW RECOVERY CODES</span></button>
</form>
