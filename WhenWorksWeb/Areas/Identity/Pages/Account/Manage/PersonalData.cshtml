@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<!-- Download links to DownloadPersonalData, which isn't scaffolded yet
     (see the Account Manage scaffolding conversation) — kept anyway,
     matching the default Identity page, and will 404 until that page is
     scaffolded in a follow-up pass. -->
<h2 class="h4 font-display text-on-gradient mb-2">@ViewData["Title"]</h2>
<hr class="account-divider w-100 mb-3" />

<div class="text-center">
    <p class="text-on-gradient">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
    <p class="text-on-gradient">
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </p>
    <form id="download-data" asp-page="DownloadPersonalData" method="post" class="d-inline">
        <button class="btn external-login-button mt-2" type="submit">Download Data</button>
    </form>
    <p class="mt-2">
        <a id="delete" asp-page="DeletePersonalData" class="btn modal-delete-button">Delete Account</a>
    </p>
</div>
