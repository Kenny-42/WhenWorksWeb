@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<!-- Reset Password confirmation page -->
<div class="text-center mb-5">
    <h1 class="ww-hero-title font-display mb-4">PASSWORD RESET</h1>
    <div class="row justify-content-center">
        <div class="col-md-5 mx-auto">
            <div class="ww-account-card ww-account-card-yellow">
                <p class="text-on-gradient fs-5 mb-0">
                    Your password has been reset. Please <a class="text-on-gradient text-link fw-semibold" asp-page="./Login">click here to log in</a>.
                </p>
            </div>
        </div>
    </div>
</div>
