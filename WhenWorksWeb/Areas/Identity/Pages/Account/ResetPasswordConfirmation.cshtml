@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<!-- Reset Password confirmation page -->
<div class="text-center">
    <h1 class="display-4 font-display text-on-gradient mb-4">PASSWORD RESET</h1>
    <p class="text-on-gradient fs-5">
        Your password has been reset. Please <a class="text-on-gradient fw-semibold" asp-page="./Login">click here to log in</a>.
    </p>
</div>
