@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<!-- Confirm email result page -->
<div class="text-center mb-5">
    <h1 class="ww-hero-title font-display mb-4">CONFIRM EMAIL</h1>
    <div class="row justify-content-center">
        <div class="col-md-5 mx-auto">
            <div class="ww-account-card ww-account-card-yellow">
                <p class="text-on-gradient fs-5 mb-3">@Model.StatusMessage</p>
                <a class="text-on-gradient text-link fw-semibold" asp-page="./Login">Back to sign in</a>
            </div>
        </div>
    </div>
</div>
