@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<!-- Reset Password page container -->
<div class="text-center">
    <h1 class="display-4 font-display text-on-gradient mb-4">RESET PASSWORD</h1>

    <div class="row justify-content-center">
        <div class="col-md-5 mx-auto">
            <section>
                <div class="account-column-heading">
                    <h2 class="h4 font-display text-on-gradient mb-2">CREATE A NEW PASSWORD</h2>
                </div>
                <hr class="account-divider w-100" />

                <form method="post" class="d-flex flex-column align-items-center gap-2">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <input asp-for="Input.Code" type="hidden" />

                    <!-- Email input -->
                    <div>
                        <label asp-for="Input.Email" class="visually-hidden"></label>
                        <input asp-for="Input.Email"
                               class="form-control input-pill input-pill-yellow mx-auto"
                               style="width: 16rem;"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="Email" />
                        <span asp-validation-for="Input.Email" class="text-danger d-block mt-1"></span>
                    </div>

                    <!-- New password input -->
                    <div>
                        <label asp-for="Input.Password" class="visually-hidden"></label>
                        <input asp-for="Input.Password"
                               class="form-control input-pill input-pill-red mx-auto"
                               style="width: 16rem;"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="New Password" />
                        <span asp-validation-for="Input.Password" class="text-danger d-block mt-1"></span>
                    </div>

                    <!-- Confirm new password input -->
                    <div>
                        <label asp-for="Input.ConfirmPassword" class="visually-hidden"></label>
                        <input asp-for="Input.ConfirmPassword"
                               class="form-control input-pill input-pill-red mx-auto"
                               style="width: 16rem;"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Confirm New Password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mt-1"></span>
                    </div>

                    <button type="submit" class="btn enter-button mt-3">SET NEW PASSWORD</button>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
