@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@* Renders the navbar links for authentication state, including the My Events link for signed-in users. *@
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);

    <!-- Link to the authenticated user's joined events page -->
    <li class="nav-item">
        <a class="nav-link nav-link-myevents" asp-controller="MyEvents" asp-action="Index">My Events</a>
    </li>

    <!-- Greeting / account management link. Hover/click colors come from the user's own
         account color, passed in as --user-color for site.css's .nav-link-username rules. -->
    <li class="nav-item">
        <a class="nav-link nav-link-username" style="--user-color: #@(currentUser?.Color ?? WhenWorksWeb.Common.ModelConstants.DefaultParticipantColor);" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @(currentUser?.DisplayName ?? User.Identity?.Name)!</a>
    </li>

    <!-- Logout form -->
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link nav-link-logout btn btn-link">Logout</button>
        </form>
    </li>
}
else
{
    <!-- Registration link for anonymous users -->
    <li class="nav-item">
        <a class="nav-link nav-link-register" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>

    <!-- Login link for anonymous users -->
    <li class="nav-item">
        <a class="nav-link nav-link-login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
