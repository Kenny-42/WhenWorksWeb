@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@* Renders the navbar links for authentication state, including the My Events link for signed-in users. *@
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var userColor = currentUser?.Color ?? WhenWorksWeb.Common.ModelConstants.DefaultParticipantColor;
    var userColorText = WhenWorksWeb.Services.ColorContrastHelper.GetReadableTextColor(userColor);

    <!-- Link to the authenticated user's joined events page -->
    <li class="nav-item">
        <a class="nav-link nav-link-myevents" asp-controller="MyEvents" asp-action="Index"><span class="ww-shiny-text">My Events</span></a>
    </li>

    <!-- Account dropdown: a person-icon toggle (yellow, matching the panel it
         opens) that reveals the manage-profile link and logout. --user-color is
         set once here on the wrapping li and inherited by the toggle/menu items
         below. --user-color-text is whichever of white/dark text reads better
         against --user-color, computed server-side (ColorContrastHelper) since
         CSS can't measure contrast against an arbitrary user-picked color. -->
    <li class="nav-item dropdown" style="--user-color: #@userColor; --user-color-text: @userColorText;">
        <a class="nav-link nav-link-account-toggle dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account">
            @* Bootstrap icon-font glyph, not a hand-drawn <svg> — only glyph content can
               sit inside a .ww-shiny-text span (background-clip: text needs glyphs to
               clip to), same as .ww-brand-badge's own icon. *@
            <span class="ww-shiny-text"><i class="bi bi-person-circle" aria-hidden="true"></i></span>
            @* Local visually-hidden technique, not Bootstrap's utility — that class is
               all !important, which would fight the mobile-only reveal below
               (.nav-link-account-label in site.css) instead of losing to it cleanly. *@
            <span class="nav-link-account-label ww-shiny-text">Account</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu">
            <!-- Account management link. Hover is the shared white-pill treatment every
                 .dropdown-item in this panel gets (site.css). -->
            <li>
                <a class="dropdown-item nav-link-username" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"><span class="ww-shiny-text">My Profile</span></a>
            </li>
            <!-- Logout form -->
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item nav-link-logout"><span class="ww-shiny-text">Logout</span></button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <!-- Registration link for anonymous users -->
    <li class="nav-item">
        <a class="nav-link nav-link-register" asp-area="Identity" asp-page="/Account/Register"><span class="ww-shiny-text">Register</span></a>
    </li>

    <!-- Login link for anonymous users -->
    <li class="nav-item">
        <a class="nav-link nav-link-login" asp-area="Identity" asp-page="/Account/Login"><span class="ww-shiny-text">Login</span></a>
    </li>
}
</ul>
