@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@* Renders the navbar links for authentication state, including the My Events link for signed-in users. *@
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var userColor = currentUser?.Color ?? WhenWorksWeb.Common.ModelConstants.DefaultParticipantColor;
    var userColorText = WhenWorksWeb.Services.ColorContrastHelper.GetReadableTextColor(userColor);

    <!-- Link to the authenticated user's joined events page -->
    <li class="nav-item">
        <a class="nav-link nav-link-myevents" asp-controller="MyEvents" asp-action="Index"><span class="ww-shiny-text">My Events</span></a>
    </li>

    <!-- Account dropdown: a person-icon toggle (yellow, matching the panel it
         opens rather than the blue/green action pills) that reveals the greeting/manage link and
         logout, which used to be two separate inline nav links. --user-color
         is set once here on the wrapping li and inherited (CSS custom
         properties cascade) by the toggle and the menu items below, same
         source as before. --user-color-text is the whichever-reads-better
         (white vs. the site's dark text color) pick computed against
         --user-color server-side (ColorContrastHelper), since CSS alone has
         no way to measure contrast against an arbitrary user-picked color —
         used by .nav-link-username's hover/focus state (site.css) the same
         way --user-color is. -->
    <li class="nav-item dropdown" style="--user-color: #@userColor; --user-color-text: @userColorText;">
        <a class="nav-link nav-link-account-toggle dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account">
            @* Bootstrap icon-font glyph, not a hand-drawn <svg> — only actual
               text/glyph content can sit inside a .ww-shiny-text span
               (background-clip: text needs glyphs to clip to; an SVG's own
               paths don't qualify), and this icon is one of those wrapped
               targets now, same as .ww-brand-badge's own icon. *@
            <span class="ww-shiny-text"><i class="bi bi-person-circle" aria-hidden="true"></i></span>
            @* Not Bootstrap's .visually-hidden utility — every property on that
               class is !important, which would fight the mobile-only reveal
               below (see .nav-link-account-label in site.css) instead of
               losing to it cleanly. Same visually-hidden technique, just
               implemented locally so it can be turned back on at the
               collapsed/hamburger breakpoint, where the toggle becomes a
               full-width labeled pill matching its sibling nav links. *@
            <span class="nav-link-account-label ww-shiny-text">Account</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu">
            <!-- Account management link. Its hover is the shared white-pill
                 one every .dropdown-item in this panel gets (site.css) — the
                 older per-user tint driven by --user-color is not currently
                 wired to any rule; the variable is still set on the list item
                 above, ready if that treatment comes back. -->
            <li>
                <a class="dropdown-item nav-link-username" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"><span class="ww-shiny-text">My Profile</span></a>
            </li>
            <!-- Logout form -->
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item nav-link-logout"><span class="ww-shiny-text">Logout</span></button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <!-- Registration link for anonymous users -->
    <li class="nav-item">
        <a class="nav-link nav-link-register" asp-area="Identity" asp-page="/Account/Register"><span class="ww-shiny-text">Register</span></a>
    </li>

    <!-- Login link for anonymous users -->
    <li class="nav-item">
        <a class="nav-link nav-link-login" asp-area="Identity" asp-page="/Account/Login"><span class="ww-shiny-text">Login</span></a>
    </li>
}
</ul>
