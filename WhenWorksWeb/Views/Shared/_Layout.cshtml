<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WhenWorksWeb.styles.css" asp-append-version="true" />
    @* Loaded globally (not scoped to the Settings tab's own Scripts block) since it's meant to be
       reusable wherever else an emoji picker is needed later. Zero runtime dependencies, Shadow
       DOM custom element — see Spec/Features/FEATURES-event-home-page.ospec's Libraries section. *@
    <script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@@^1/index.js"></script>
</head>
<body>
    <!-- Fixed full-viewport canvas the animated background blobs are drawn onto in JS
         (wwwroot/js/site.js) rather than via a CSS animation, which failed to reliably
         repaint for a live viewer across real browsers. aria-hidden since it's purely
         decorative.
         Must stay the first element in <body>, with #ww-page-content below as the ONLY
         sibling after it: site.css positions this canvas fixed/full-viewport with no
         z-index (a negative z-index silently stopped a *gradient* canvas from
         compositing at all — see #ww-gradient-canvas in site.css). Without a z-index,
         position: fixed still opens its own stacking context, which paints ABOVE any
         plain static sibling regardless of DOM order; #ww-page-content's own
         position: relative promotes real page content into that same stacking context
         so DOM order (canvas first) decides paint order correctly. Dropping that
         wrapper, or adding new top-level content as a sibling of the canvas instead of
         inside #ww-page-content, would bring the bug back. If canvas/JS is unavailable,
         the static gradient set on body in site.css shows through underneath. -->
    <canvas id="ww-gradient-canvas" aria-hidden="true"></canvas>

    <div id="ww-page-content">
        <!-- Site header: brand link, Admin nav item (shown only to Admins), and the login/logout partial -->
        <header>
            @* Every color Bootstrap's navbar-dark/navbar-light modifiers would set is
               already overridden explicitly below (site.css .navbar rule) for the
               transparent-nav theme, so neither modifier class is used here. *@
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="ww-brand-badge"><span class="ww-shiny-text"><i class="bi bi-stars" aria-hidden="true"></i></span></span>
                        @* "WhenWorks." is one flex item, not two — .navbar-brand's own
                           gap (meant to space the badge from the wordmark) would
                           otherwise also land between the wordmark text and the dot
                           span if they were separate children of the flex container. *@
                        <span>WhenWorks<span class="ww-brand-dot">.</span></span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="ww-shiny-text"><i class="bi bi-list" aria-hidden="true"></i></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-page="/Users/ManageUsers"><span class="ww-shiny-text">Manage Users</span></a>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main content area: renders whichever view is being displayed -->
        <div class="container">
            @* No pb-3 here — a page's own last element controls its own trailing
               spacing (e.g. Home's .ww-feature-band sits flush against the footer
               on purpose; see site.css). *@
            <main role="main" class="pt-4">
                @RenderBody()
            </main>
        </div>

        <!-- Site footer -->
        <footer class="footer">
            <div class="container">
                <span class="ww-footer-pill">&copy; 2026 - WhenWorksWeb - <a class="text-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></span>
            </div>
        </footer>
    </div>

    <!-- Shared scripts: jQuery, Bootstrap bundle, site-wide JS, then any per-view Scripts section -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
