@model WhenWorksWeb.Models.IndexViewModel

@{
    ViewData["Title"] = "Home Page";
}

<!-- Page container for the home screen content -->
<div class="text-center">

    <!-- Create Event section -->
    <div class="create-event-container d-flex flex-column align-items-center gap-2">
        <h1 class="display-4">CREATE A NEW EVENT</h1>

        <!-- Event name input and submit button are aligned horizontally for a compact layout -->
        <div class="d-flex align-items-start gap-2">
            <input type="text"
                   class="form-control form-control-sm text-center"
                   style="width: 14rem;"
                   placeholder="Event Name">
            <button class="btn btn-primary">GO!</button>
        </div>
    </div>

    <!-- Join Event section -->
    <div class="join-event-container d-flex flex-column align-items-center gap-2">
        <h2 class="display-5">JOIN AN EVENT</h2>

        <!-- Form posts the entered event code to the JoinEvent action -->
        <form asp-action="JoinEvent" asp-controller="Home" method="post"
              class="d-flex flex-column align-items-center gap-2">

            <!-- Event code input and submit button are aligned horizontally for a compact layout -->
            <div class="d-flex align-items-start gap-2">
                <input asp-for="EventCode"
                       class="form-control form-control-sm text-uppercase text-center"
                       style="width: 13ch;"
                       maxlength="6"
                       autocomplete="off"
                       autocapitalize="characters"
                       oninput="this.value = this.value.toUpperCase();"
                       placeholder="Event Code" />

                <button type="submit" class="btn btn-primary">GO!</button>
            </div>

            <!-- Validation summary and field-specific validation messages appear below the controls -->
            <div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <span asp-validation-for="EventCode" class="text-danger d-block"></span>

                <!-- Success message is displayed after a valid event code submission -->
                @if (ViewData["SuccessMessage"] is string successMessage)
                {
                    <div class="text-success">@successMessage</div>
                }
            </div>
        </form>
    </div>
</div>