@using System.Security.Claims
@using System.Text.Json
@model WhenWorksWeb.Models.MyEventsPageViewModel

@* Displays one page of the signed-in user's joined events as a grid of cards, each with its own direct
   "Enter" action and delete trigger, plus page-number navigation across however many pages of events exist. *@
@{
    ViewData["Title"] = "My Events";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    var participantsJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<!-- Page container -->
<div class="container py-4" style="max-width: 64rem;">

    <!-- Page header: hero badge/heading/subheading on the left, "New Event" action on the right -->
    <div class="ww-myevents-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="ww-hero-badge mb-3">
                <span class="ww-hero-badge-dot" aria-hidden="true"></span>
                <span class="ww-shiny-text">YOUR EVENTS</span>
            </span>
            <h1 class="ww-hero-title font-display mb-3">
                Big plans,<br>
                <span class="ww-hero-title-accent">all in one place.</span>
            </h1>
            <p class="ww-hero-subtitle mb-0">
                Manage all the events you've joined, or pick up where the group left off.
            </p>
        </div>

        <!-- Creates a new event immediately (default title, no name-entry step) and sends the user straight to
             its sign-in page — the same quick-create action the navbar's own "New Event" button posts to. -->
        <form asp-controller="Events" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CreateEventName" value="@WhenWorksWeb.Common.ModelConstants.DefaultEventTitle" />
            <button type="submit" class="go-button ww-myevents-new-button">
                <span class="ww-shiny-text"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Event</span>
            </button>
        </form>
    </div>

    <!-- Empty state shown when the user has not joined any events -->
    @if (Model.Events.Count == 0)
    {
        <p class="text-on-gradient fw-bold text-center mb-0">
            Oops! You have not joined any events yet.
        </p>
    }
    else
    {
        <!-- Event card grid -->
        <div class="row row-cols-1 row-cols-md-2 g-4" id="my-events-grid">
            @for (var index = 0; index < Model.Events.Count; index++)
            {
                var myEvent = Model.Events[index];
                var isCreatedByCurrentUser = string.Equals(myEvent.CreatedByUserId, currentUserId, StringComparison.Ordinal);
                var participantsJson = JsonSerializer.Serialize(myEvent.Participants, participantsJsonOptions);

                <div class="col ww-myevent-card-slot" style="--ww-card-index: @index;">
                    <div class="ww-myevent-card"
                         data-event-id="@myEvent.EventId"
                         data-participants="@participantsJson"
                         data-has-participant="@((myEvent.Participants.Count > 0).ToString().ToLowerInvariant())"
                         data-created-by-current-user="@isCreatedByCurrentUser.ToString().ToLowerInvariant()">

                        <!-- Top row: copiable event code + total participant count, and the event's own emoji -->
                        <div class="ww-myevent-card-top d-flex align-items-start justify-content-between">
                            <div class="ww-myevent-code-row">
                                <span class="ww-myevent-code font-mono">@myEvent.Code</span>
                                <button type="button" class="ww-myevent-copy-button" data-code="@myEvent.Code" aria-label="Copy event code" title="Copy event code">
                                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                                </button>
                                <span class="ww-myevent-people">
                                    &middot; @myEvent.TotalParticipantCount @(myEvent.TotalParticipantCount == 1 ? "PERSON" : "PEOPLE")
                                </span>
                            </div>
                            <span class="ww-myevent-emoji" aria-hidden="true">@myEvent.Emoji</span>
                        </div>

                        <h3 class="ww-myevent-title font-display ww-autofit-title">@myEvent.Title</h3>
                        <p class="ww-myevent-description">@myEvent.Description</p>

                        <div class="ww-myevent-divider"></div>

                        <!-- Bottom row: organizer avatars, delete trigger, and the direct Enter action -->
                        <div class="ww-myevent-footer d-flex align-items-center justify-content-between gap-2">
                            <div class="ww-myevent-avatars">
                                @foreach (var participant in myEvent.Participants)
                                {
                                    <span class="ww-myevent-avatar" style="--avatar-color:#@participant.Color" title="@participant.DisplayName">
                                        @participant.DisplayName.Substring(0, 1).ToUpperInvariant()
                                    </span>
                                }
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="ww-myevent-delete-button" aria-label="Delete event" title="Delete event">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                                <a href="@myEvent.SignInUrl" class="go-button ww-myevent-enter-button">
                                    <span class="ww-shiny-text">Enter <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Page navigation: previous/next, a window of nearby page numbers, a jump-to-page box, and a link to
             the last page. Plain links (a full page load) since events are paginated server-side. -->
        @if (Model.TotalPages > 1)
        {
            var windowStart = Math.Max(1, Model.CurrentPage - 2);
            var windowEnd = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

            <nav class="ww-myevents-pagination mt-4" aria-label="Events pages">
                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   class="ww-page-button ww-page-nav-button @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   aria-label="Previous page"
                   aria-disabled="@(Model.CurrentPage <= 1 ? "true" : "false")">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </a>

                @if (windowStart > 1)
                {
                    <a asp-action="Index" asp-route-page="1" class="ww-page-button">1</a>
                    @if (windowStart > 2)
                    {
                        <span class="ww-page-ellipsis">&hellip;</span>
                    }
                }

                @for (var pageNumber = windowStart; pageNumber <= windowEnd; pageNumber++)
                {
                    <a asp-action="Index"
                       asp-route-page="@pageNumber"
                       class="ww-page-button @(pageNumber == Model.CurrentPage ? "active" : "")"
                       aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                        @pageNumber
                    </a>
                }

                @if (windowEnd < Model.TotalPages)
                {
                    @if (windowEnd < Model.TotalPages - 1)
                    {
                        <span class="ww-page-ellipsis">&hellip;</span>
                    }
                    <a asp-action="Index" asp-route-page="@Model.TotalPages" class="ww-page-button">@Model.TotalPages</a>
                }

                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   class="ww-page-button ww-page-nav-button @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   aria-label="Next page"
                   aria-disabled="@(Model.CurrentPage >= Model.TotalPages ? "true" : "false")">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>

                <form asp-action="Index" method="get" class="ww-page-jump-form" id="my-events-page-jump-form">
                    <label for="my-events-page-jump-input" class="visually-hidden">Go to page</label>
                    <input type="number"
                           inputmode="numeric"
                           name="page"
                           id="my-events-page-jump-input"
                           class="input-pill ww-page-jump-input"
                           min="1"
                           max="@Model.TotalPages"
                           value="@Model.CurrentPage"
                           data-current-page="@Model.CurrentPage"
                           aria-label="Go to page (1 to @Model.TotalPages)" />
                </form>
            </nav>
        }

        <!-- Delete confirmation modal -->
        <div class="modal fade" id="delete-event-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delete-modal-content">
                    <form asp-controller="MyEvents" asp-action="Delete" method="post" id="delete-event-form">
                        @Html.AntiForgeryToken()

                        <div class="modal-header">
                            <h5 class="modal-title font-display" id="delete-event-modal-title">Delete Confirmation</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body">
                            <input type="hidden" name="eventId" id="delete-event-id" />
                            <input type="hidden" name="participantId" id="delete-participant-id" />
                            <input type="hidden" name="deleteMode" id="delete-mode" />
                            <input type="hidden" name="page" value="@Model.CurrentPage" />

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input delete-option-radio" type="radio" name="deleteChoice" id="delete-participant-option" value="participant" />
                                    <label class="form-check-label" for="delete-participant-option">Select a participant to delete</label>
                                </div>

                                <div class="ms-4 mt-2" id="participant-delete-container">
                                    <select class="form-select input-pill input-pill-red select-arrow-inset w-100" id="participant-delete-select">
                                        <option value="">Select a participant</option>
                                    </select>

                                    <div class="text-danger small d-none" id="participant-delete-unavailable-text">
                                        You have not joined this event.
                                    </div>
                                </div>
                            </div>

                            <div class="mb-0">
                                <div class="form-check">
                                    <input class="form-check-input delete-option-radio" type="radio" name="deleteChoice" id="delete-event-option" value="event" />
                                    <label class="form-check-label" for="delete-event-option">Delete the whole event</label>
                                </div>

                                <div class="ms-4 mt-2 text-danger small d-none" id="event-delete-unavailable-text">
                                    You do not have permission to delete this event.
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn modal-cancel-button" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn modal-delete-button" id="delete-submit-button" disabled>Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Client-side behavior: per-card delete trigger, code-copy button, and the jump-to-page form -->
@section Scripts {
    <script>
        (function () {
            const grid = document.getElementById('my-events-grid');

            const deleteModalElement = document.getElementById('delete-event-modal');
            const deleteModalTitle = document.getElementById('delete-event-modal-title');
            const deleteForm = document.getElementById('delete-event-form');
            const deleteEventIdInput = document.getElementById('delete-event-id');
            const deleteParticipantIdInput = document.getElementById('delete-participant-id');
            const deleteModeInput = document.getElementById('delete-mode');
            const deleteSubmitButton = document.getElementById('delete-submit-button');
            const participantRadio = document.getElementById('delete-participant-option');
            const eventRadio = document.getElementById('delete-event-option');
            const participantSelect = document.getElementById('participant-delete-select');
            const participantDeleteContainer = document.getElementById('participant-delete-container');
            const participantUnavailableText = document.getElementById('participant-delete-unavailable-text');
            const eventUnavailableText = document.getElementById('event-delete-unavailable-text');

            const pageJumpForm = document.getElementById('my-events-page-jump-form');
            const pageJumpInput = document.getElementById('my-events-page-jump-input');

            // The jump-to-page box and the delete modal are independent features — a missing grid (empty state) or
            // missing modal (also only rendered when there are events) shouldn't stop the other from wiring up.
            if (pageJumpForm && pageJumpInput) {
                var maxPage = parseInt(pageJumpInput.getAttribute('max') || '1', 10);
                var currentPage = parseInt(pageJumpInput.dataset.currentPage || '1', 10);

                pageJumpForm.addEventListener('submit', function (event) {
                    // An emptied/invalid box falls back to the page already being displayed, not page 1 — the
                    // input's own default value is the current page, so this only matters if the user cleared it.
                    var requested = parseInt(pageJumpInput.value, 10);
                    if (!requested || requested < 1) {
                        requested = currentPage;
                    }
                    else if (requested > maxPage) {
                        requested = maxPage;
                    }
                    pageJumpInput.value = requested.toString();
                });
            }

            // Copy-to-clipboard for each card's event code, with a brief "copied" confirmation state.
            if (grid) {
                grid.addEventListener('click', function (event) {
                    const copyButton = event.target.closest('.ww-myevent-copy-button');
                    if (!copyButton || !grid.contains(copyButton)) {
                        return;
                    }

                    const code = copyButton.dataset.code || '';
                    if (!code || !navigator.clipboard) {
                        return;
                    }

                    navigator.clipboard.writeText(code).then(function () {
                        copyButton.classList.add('copied');
                        window.clearTimeout(copyButton._copiedTimeout);
                        copyButton._copiedTimeout = window.setTimeout(function () {
                            copyButton.classList.remove('copied');
                        }, 1500);
                    }).catch(function () {
                        // Clipboard access can be denied by the browser/OS — silently no-op rather than
                        // surfacing a broken-looking error for a purely convenience feature.
                    });
                });
            }

            if (!grid || !deleteModalElement || !deleteModalTitle || !deleteForm ||
                !deleteEventIdInput || !deleteParticipantIdInput || !deleteModeInput || !deleteSubmitButton ||
                !participantRadio || !eventRadio || !participantSelect || !participantDeleteContainer ||
                !participantUnavailableText || !eventUnavailableText) {
                return;
            }

            const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalElement);

            function syncDeleteButtonState() {
                const selectedRadio = deleteForm.querySelector('input[name="deleteChoice"]:checked');

                deleteModeInput.value = selectedRadio ? selectedRadio.value : '';
                deleteSubmitButton.disabled = !selectedRadio || selectedRadio.disabled;

                if (selectedRadio && selectedRadio.value === 'participant') {
                    participantSelect.disabled = false;
                    deleteParticipantIdInput.value = participantSelect.value || '';
                }
                else {
                    participantSelect.disabled = true;
                    deleteParticipantIdInput.value = '';
                }
            }

            function resetDeleteModal() {
                deleteForm.reset();
                deleteEventIdInput.value = '';
                deleteParticipantIdInput.value = '';
                deleteModeInput.value = '';
                deleteSubmitButton.disabled = true;

                participantSelect.innerHTML = '<option value="">Select a participant</option>';
                participantSelect.disabled = true;
                participantDeleteContainer.classList.remove('d-none');

                participantRadio.disabled = false;
                eventRadio.disabled = false;
                participantRadio.checked = false;
                eventRadio.checked = false;

                participantUnavailableText.classList.add('d-none');
                eventUnavailableText.classList.add('d-none');
            }

            function openDeleteModal(card) {
                resetDeleteModal();

                deleteEventIdInput.value = card.dataset.eventId || '';
                deleteModalTitle.textContent = 'Delete Confirmation';

                let participants = [];
                try {
                    participants = JSON.parse(card.dataset.participants || '[]');
                }
                catch {
                    participants = [];
                }

                const hasParticipant = card.dataset.hasParticipant === 'true' && participants.length > 0;
                const isCreatedByCurrentUser = card.dataset.createdByCurrentUser === 'true';

                if (hasParticipant) {
                    participantSelect.innerHTML = '';

                    participants.forEach(function (participant, index) {
                        const participantOption = document.createElement('option');
                        participantOption.value = participant.participantId;
                        participantOption.textContent = participant.displayName || 'Participant';
                        participantOption.selected = index === 0;
                        participantSelect.appendChild(participantOption);
                    });

                    participantUnavailableText.classList.add('d-none');
                    participantDeleteContainer.classList.remove('d-none');
                    participantRadio.disabled = false;
                }
                else {
                    participantDeleteContainer.classList.add('d-none');
                    participantUnavailableText.classList.remove('d-none');
                    participantRadio.disabled = true;
                }

                if (isCreatedByCurrentUser) {
                    eventRadio.disabled = false;
                    eventUnavailableText.classList.add('d-none');
                }
                else {
                    eventRadio.disabled = true;
                    eventUnavailableText.classList.remove('d-none');
                }

                deleteParticipantIdInput.value = hasParticipant ? participantSelect.value : '';
                deleteSubmitButton.disabled = true;

                deleteModal.show();
            }

            // Each card's trash icon opens the delete modal for that specific event.
            grid.addEventListener('click', function (event) {
                const deleteButton = event.target.closest('.ww-myevent-delete-button');
                if (!deleteButton || !grid.contains(deleteButton)) {
                    return;
                }

                const card = deleteButton.closest('.ww-myevent-card');
                if (!card) {
                    return;
                }

                event.preventDefault();
                openDeleteModal(card);
            });

            participantRadio.addEventListener('change', function () {
                if (participantRadio.checked) {
                    participantSelect.disabled = false;
                    deleteParticipantIdInput.value = participantSelect.value || '';
                }
                syncDeleteButtonState();
            });

            eventRadio.addEventListener('change', function () {
                if (eventRadio.checked) {
                    participantSelect.disabled = true;
                    deleteParticipantIdInput.value = '';
                }
                syncDeleteButtonState();
            });

            participantSelect.addEventListener('change', function () {
                if (participantRadio.checked) {
                    deleteParticipantIdInput.value = participantSelect.value || '';
                }
            });

            deleteForm.addEventListener('change', syncDeleteButtonState);

            deleteModalElement.addEventListener('hidden.bs.modal', resetDeleteModal);

            resetDeleteModal();
        })();
    </script>
}
