@using System.Text.Json
@model WhenWorksWeb.Models.EventSettingsViewModel

@{
    ViewData["Title"] = Model.Header.Title;
    ViewData["DisableTitleSuffix"] = true;

    var calendarJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var calendarJson = JsonSerializer.Serialize(Model.Calendar, calendarJsonOptions);
}

<!-- Event Settings tab: shared header/tab bar, then "Shape the plan" + "Call the date"/Delete
     Event. Reuses .ww-availability-layout/.ww-availability-sidebar's generic two-column grid
     (main card + stacked side cards) rather than introducing a second layout for the same shape. -->
<div class="container py-4 ww-settings-page" style="max-width: 64rem;">
    @await Html.PartialAsync("_EventHeader", Model.Header)

    @if (!Model.CanManageEvent)
    {
        <div class="ww-event-card text-center mb-4">
            <p class="mb-0">Only this event's organizer can manage its details, final dates, and deletion.</p>
        </div>
    }

    <div class="ww-availability-layout">
        <!-- "Shape the plan" card: title/description/emoji, organizer-only. -->
        <div class="ww-event-card ww-settings-shape-card">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <h2 class="font-display mb-0">Shape the plan</h2>
                <i class="bi bi-sliders" aria-hidden="true"></i>
            </div>
            <p class="ww-people-subtitle mb-3">Only the organizer can edit these details.</p>

            <form asp-route="EventUpdateDetails" asp-route-code="@Model.Header.Code" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="ww-settings-title" class="ww-settings-label">Event title</label>
                    <input type="text"
                           id="ww-settings-title"
                           name="title"
                           class="form-control input-pill input-pill-yellow ww-settings-input w-100"
                           maxlength="@WhenWorksWeb.Common.ModelConstants.EventTitleMaxLength"
                           value="@Model.Title"
                           disabled="@(!Model.CanManageEvent)"
                           required />
                </div>

                <div class="mb-3">
                    <label for="ww-settings-description" class="ww-settings-label">Description</label>
                    <textarea id="ww-settings-description"
                              name="description"
                              class="form-control ww-settings-textarea"
                              maxlength="@WhenWorksWeb.Common.ModelConstants.EventDescriptionMaxLength"
                              rows="4"
                              placeholder="A new plan is taking shape."
                              disabled="@(!Model.CanManageEvent)">@Model.Description</textarea>
                </div>

                <div class="mb-3">
                    <label class="ww-settings-label d-block">Event emoji</label>
                    <input type="hidden" id="ww-settings-emoji-input" name="emoji" value="@Model.Emoji" />
                    <button type="button"
                            id="ww-settings-emoji-button"
                            class="ww-settings-emoji-button"
                            aria-haspopup="true"
                            aria-expanded="false"
                            disabled="@(!Model.CanManageEvent)">
                        <span id="ww-settings-emoji-preview">@Model.Emoji</span>
                    </button>
                    <div id="ww-settings-emoji-popup" class="ww-settings-emoji-popup d-none">
                        <emoji-picker id="ww-settings-emoji-picker"></emoji-picker>
                    </div>
                </div>

                @if (Model.CanManageEvent)
                {
                    <button type="submit" class="btn go-button">Save changes <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                }
            </form>
        </div>

        <!-- "Call the date"/Delete Event sidebar. -->
        <div class="ww-availability-sidebar">
            <div class="ww-event-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h3 class="font-display mb-0">Call the date</h3>
                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                </div>
                <p class="ww-people-subtitle mb-3">Select a final date independently of availability.</p>
                @* "Suggestions"/"Final dates" sub-lists below. *@

                <h4 class="ww-settings-sublabel">Suggestions</h4>
                <div id="ww-final-date-suggestions"
                     data-calendar="@calendarJson"
                     class="mb-3">
                </div>

                @if (Model.CanManageEvent)
                {
                    <form asp-route="EventAddFinalDate" asp-route-code="@Model.Header.Code" method="post" class="ww-settings-add-date-form mb-3">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <div class="d-flex align-items-center justify-content-between">
                                <label for="ww-final-date-start" class="ww-settings-label mb-0">Start date</label>
                                <button type="button" class="ww-settings-clear-date-button" data-clear-target="ww-final-date-start">Clear</button>
                            </div>
                            <input type="date" id="ww-final-date-start" name="startDate" class="form-control input-pill input-pill-yellow ww-settings-input w-100" required />
                        </div>
                        <div class="mb-2">
                            <div class="d-flex align-items-center justify-content-between">
                                <label for="ww-final-date-end" class="ww-settings-label mb-0">End date <span class="ww-settings-optional-tag">(optional)</span></label>
                                <button type="button" class="ww-settings-clear-date-button" data-clear-target="ww-final-date-end">Clear</button>
                            </div>
                            <input type="date" id="ww-final-date-end" name="endDate" class="form-control input-pill input-pill-yellow ww-settings-input w-100" />
                        </div>
                        <button type="submit" class="btn go-button w-100">Add a date <i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                    </form>
                }
            </div>

            <!-- Final dates: its own card (not a sub-section of "Call the date") so a confirmed
                 date reads as a bigger, more settled result than a suggestion, with a full h3
                 heading (not .ww-settings-sublabel's smaller sub-heading size) to match. -->
            <div class="ww-event-card">
                <h3 class="font-display mb-3">Final dates</h3>
                @if (Model.FinalDates.Count == 0)
                {
                    <p class="ww-people-subtitle mb-0">No final date set yet.</p>
                }
                else
                {
                    @foreach (var finalDate in Model.FinalDates)
                    {
                        <div class="ww-final-date-row">
                            <span class="ww-final-date-label ww-autofit-title" data-max-lines="1" data-min-font-size="9">
                                @(finalDate.EndDate is null
                                    ? finalDate.StartDate.ToString("MMM d")
                                    : $"{finalDate.StartDate:MMM d} – {finalDate.EndDate:MMM d}")
                            </span>
                            @if (Model.CanManageEvent)
                            {
                                <form asp-route="EventRemoveFinalDate" asp-route-code="@Model.Header.Code" asp-route-finalDateId="@finalDate.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ww-final-date-remove-button" aria-label="Remove this final date">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    }
                }
            </div>

            @if (Model.CanManageEvent)
            {
                <button type="button" class="ww-delete-event-button" data-bs-toggle="modal" data-bs-target="#delete-event-modal">
                    <i class="bi bi-trash" aria-hidden="true"></i> Delete Event
                </button>
            }
        </div>
    </div>

    @if (Model.CanManageEvent)
    {
        <!-- Delete confirmation modal — same visual pattern as MyEvents/Index.cshtml's, adapted to
             a single whole-event confirmation (no participant-vs-event choice needed here). -->
        <div class="modal fade" id="delete-event-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delete-modal-content">
                    <form asp-route="EventDelete" asp-route-code="@Model.Header.Code" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title font-display">Delete Confirmation</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">Delete "@Model.Header.Title"? This removes the event and everyone's picks — this can't be undone.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn modal-cancel-button" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn modal-delete-button">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/event-best-bets.js"></script>
    <script>
        (function () {
            "use strict";

            // "Suggestions" sub-list — the same best-bets ranking as the Availability tab's
            // sidebar, rendered by the shared script. Clicking a suggestion prefills the add-date
            // form's start field rather than adding it directly, so the organizer still confirms.
            var suggestionsEl = document.getElementById('ww-final-date-suggestions');
            if (suggestionsEl) {
                var calendar = JSON.parse(suggestionsEl.dataset.calendar);
                var participantsById = {};
                calendar.participants.forEach(function (p) {
                    participantsById[p.id] = p;
                });

                var datesByKey = {};
                calendar.dates.forEach(function (d) {
                    datesByKey[d.date] = d.participantIds.slice();
                });

                var startInput = document.getElementById('ww-final-date-start');

                WWBestBets.renderBestBetsList(suggestionsEl, datesByKey, participantsById, calendar.participants.length, {
                    emptyText: 'Suggestions will appear once your group starts picking.',
                    onSelect: startInput
                        ? function (date) {
                            startInput.value = date;
                            startInput.dispatchEvent(new Event('change'));
                        }
                        : undefined
                });
            }

            // Cross-constrain the add-date range so the native picker itself grays out/blocks an
            // invalid end date, rather than only catching it after submit: the end field can never
            // be set before whatever start date is currently chosen, and the start field can never
            // be moved past whatever end date is currently chosen.
            var rangeStartInput = document.getElementById('ww-final-date-start');
            var rangeEndInput = document.getElementById('ww-final-date-end');
            if (rangeStartInput && rangeEndInput) {
                rangeStartInput.addEventListener('change', function () {
                    rangeEndInput.min = rangeStartInput.value || '';
                });
                rangeEndInput.addEventListener('change', function () {
                    rangeStartInput.max = rangeEndInput.value || '';
                });
            }

            // "Clear" buttons beside each date field — lets the organizer start over (fully or
            // partially) instead of being stuck once a date is picked, since a native date input
            // has no built-in way to blank itself back out once set. Clearing dispatches the same
            // 'change' event the cross-constraint listeners above already react to, so clearing
            // the start date also lifts the end field's min (and vice versa).
            document.querySelectorAll('.ww-settings-clear-date-button').forEach(function (button) {
                button.addEventListener('click', function () {
                    var target = document.getElementById(button.dataset.clearTarget);
                    if (!target) {
                        return;
                    }
                    target.value = '';
                    target.dispatchEvent(new Event('change'));
                });
            });

            // Emoji picker popup, wired the same way anywhere else this custom element gets used
            // later: toggle a popup containing <emoji-picker>, write the pick into the hidden
            // field the form actually submits, and update the trigger button's preview.
            var emojiButton = document.getElementById('ww-settings-emoji-button');
            var emojiPopup = document.getElementById('ww-settings-emoji-popup');
            var emojiPicker = document.getElementById('ww-settings-emoji-picker');
            var emojiInput = document.getElementById('ww-settings-emoji-input');
            var emojiPreview = document.getElementById('ww-settings-emoji-preview');

            if (emojiButton && emojiPopup && emojiPicker) {
                emojiButton.addEventListener('click', function () {
                    var isOpen = !emojiPopup.classList.contains('d-none');
                    emojiPopup.classList.toggle('d-none', isOpen);
                    emojiButton.setAttribute('aria-expanded', String(!isOpen));
                });

                emojiPicker.addEventListener('emoji-click', function (event) {
                    var unicode = event.detail.unicode;
                    emojiInput.value = unicode;
                    emojiPreview.textContent = unicode;
                    emojiPopup.classList.add('d-none');
                    emojiButton.setAttribute('aria-expanded', 'false');
                });

                document.addEventListener('click', function (event) {
                    // emojiButton.contains(...), not a strict !== check — a click on the emoji
                    // preview span or (previously) the pencil icon inside the button is its own
                    // event.target, which is a descendant of the button, not the button itself,
                    // so a strict comparison treated it as an outside click and closed the popup
                    // the instant it opened.
                    if (!emojiPopup.classList.contains('d-none') &&
                        !emojiPopup.contains(event.target) &&
                        !emojiButton.contains(event.target)) {
                        emojiPopup.classList.add('d-none');
                        emojiButton.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        })();
    </script>
}
