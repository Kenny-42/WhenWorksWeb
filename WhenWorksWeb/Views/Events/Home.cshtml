@model WhenWorksWeb.Models.EventHomeViewModel

@{
    ViewData["Title"] = Model.Title;
    ViewData["DisableTitleSuffix"] = true;
}

<!-- Event home container -->
<div class="container py-4" style="max-width: 32rem;">
    <div class="text-center">
        <h1 class="ww-hero-title font-display mb-3 ww-autofit-title">@Model.Title</h1>
        <p class="lead mb-1 text-on-gradient">You have entered the event successfully.</p>
        <p class="text-on-gradient mb-0">Event code: <strong>@Model.Code</strong></p>
    </div>
</div>