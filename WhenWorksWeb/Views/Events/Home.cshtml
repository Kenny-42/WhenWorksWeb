@using System.Text.Json
@model WhenWorksWeb.Models.EventHomeViewModel

@{
    ViewData["Title"] = Model.Header.Title;
    ViewData["DisableTitleSuffix"] = true;

    var calendarJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var calendarJson = JsonSerializer.Serialize(Model.Calendar, calendarJsonOptions);
}

<!-- Event home container: shared header/tab bar, then the calendar + best-bets/status sidebar.
     Wider than the other two tabs' 48rem container since this is a two-column layout. -->
<div class="container py-4" style="max-width: 64rem;">
    @await Html.PartialAsync("_EventHeader", Model.Header)

    <div class="ww-availability-layout">
        <!-- Calendar card: month grid + legend. Entirely rendered/updated by JS below from the
             data-calendar JSON blob, so paging months and toggling a date never need a server
             round trip beyond the small POST the toggle itself makes. -->
        <div class="ww-event-card ww-calendar-card">
            <div class="ww-calendar-header">
                <button type="button" class="ww-calendar-nav-button" data-direction="-1" aria-label="Previous month">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
                <div class="ww-calendar-title">
                    <h2 id="ww-calendar-month-label" class="font-display mb-0"></h2>
                    <p class="ww-calendar-subtitle font-display mb-0 text-muted">Click a date to mark yourself available</p>
                </div>
                <button type="button" class="ww-calendar-nav-button" data-direction="1" aria-label="Next month">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>

            <div class="ww-calendar-weekdays" aria-hidden="true">
                <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
            </div>

            <div class="ww-calendar-grid"
                 id="ww-calendar-grid"
                 data-calendar="@calendarJson"
                 data-code="@Model.Header.Code"
                 role="grid"
                 aria-label="Availability calendar">
            </div>

            <hr class="ww-event-divider" style="margin-top: 1rem;" />

            <div class="ww-calendar-legend" id="ww-calendar-legend" aria-label="Participant color key"></div>
        </div>

        <!-- Sidebar: once a final date exists, "Final dates" sits above Best Bets (still useful
             for spotting a second date the group could switch to) in place of the status card,
             which no longer has anything left to prompt once a date's already been chosen —
             decided here, server-side, since it's already known at render time. Where the status
             card *does* show (no final date yet), it sits above Best Bets too — it's the more
             actionable of the two. "Final dates" is a live, non-interactive card with the same
             recolored-outline treatment as the status card below (pink instead of the sitewide
             yellow) — deliberately opted out of the .ww-feature-card proximity-glow/spotlight-
             tint/hover-confetti system Home's marketing cards use. -->
        <div class="ww-availability-sidebar">
            @if (Model.Calendar.FinalDates.Count > 0)
            {
                <div class="ww-event-card ww-final-dates-card" id="ww-final-dates-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h3 class="font-display mb-0">Final dates</h3>
                        <i class="bi bi-calendar-check" aria-hidden="true"></i>
                    </div>
                    <div id="ww-final-dates-list"></div>
                    @if (Model.CanManageEvent)
                    {
                        <a asp-route="EventFinalize" asp-route-code="@Model.Header.Code" class="btn ww-status-button mt-2">Choose another date</a>
                    }
                </div>
            }
            else
            {
                <div class="ww-event-card" id="ww-status-card"></div>
            }

            <div class="ww-event-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h3 class="font-display mb-0">Best bets</h3>
                    <i class="bi bi-stars" aria-hidden="true"></i>
                </div>
                <div id="ww-best-bets-list"></div>
            </div>
        </div>
    </div>

    <!-- Hidden antiforgery token the calendar's fetch-based toggle POST sends the same way a
         normal form submit would, just without a full-page navigation. -->
    <form id="ww-availability-antiforgery-form" class="visually-hidden">
        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    <script src="~/js/event-best-bets.js"></script>
    <script>
        (function () {
            "use strict";

            var gridEl = document.getElementById('ww-calendar-grid');
            if (!gridEl) {
                return;
            }

            var calendar = JSON.parse(gridEl.dataset.calendar);
            var code = gridEl.dataset.code;
            var tokenInput = document.querySelector('#ww-availability-antiforgery-form input[name="__RequestVerificationToken"]');

            var monthLabelEl = document.getElementById('ww-calendar-month-label');
            var legendEl = document.getElementById('ww-calendar-legend');
            var bestBetsEl = document.getElementById('ww-best-bets-list');
            var statusEl = document.getElementById('ww-status-card');
            var finalDatesEl = document.getElementById('ww-final-dates-list');
            var prevButton = document.querySelector('.ww-calendar-nav-button[data-direction="-1"]');
            var nextButton = document.querySelector('.ww-calendar-nav-button[data-direction="1"]');

            var MONTH_NAMES = [
                'January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'
            ];

            // Participants, keyed by id, for color/name lookups everywhere below.
            var participantsById = {};
            calendar.participants.forEach(function (p) {
                participantsById[p.id] = p;
            });

            // 'yyyy-MM-dd' -> participant ids available that day. The single source of truth for
            // wedges, the legend's picks, best bets, and the status card — updated in place after
            // every toggle so all of those stay consistent without a page reload.
            var datesByKey = {};
            calendar.dates.forEach(function (d) {
                datesByKey[d.date] = d.participantIds.slice();
            });

            // 'yyyy-MM-dd' -> true for every day covered by an organizer-chosen final date —
            // computed once since final dates only change via a full-page Finalize action, unlike
            // datesByKey above which is updated in place after every toggle.
            var finalDateKeys = WWBestBets.getFinalDateKeys(calendar.finalDates);

            var windowStart = parseMonth(calendar.windowStartMonth);
            var windowEnd = parseMonth(calendar.windowEndMonth);
            var viewMonth = parseMonth(calendar.initialMonth);

            gridEl.style.setProperty('--current-participant-color', '#' + colorFor(calendar.currentParticipantId));

            // The event's own emoji (rendered once already, in the page header) — reused as the
            // final-date marker overlaid on an organizer-chosen date, so it reads as *this
            // event's* celebration rather than a generic icon. Falls back to a party popper on
            // the off chance the header emoji isn't on the page for some reason.
            var eventEmojiEl = document.querySelector('.ww-event-title-emoji');
            var eventEmoji = (eventEmojiEl && eventEmojiEl.textContent.trim()) || '🎉';

            // Confetti burst colors — the site's own pink/yellow/green/blue accents, cycled per
            // particle so the burst reads as multicolored rather than a single flat tint.
            var rootStyle = window.getComputedStyle(document.documentElement);
            var CONFETTI_COLORS = [
                rootStyle.getPropertyValue('--color-accent-pink-fill').trim() || '#ff66c4',
                rootStyle.getPropertyValue('--color-accent-yellow-fill').trim() || '#f2d675',
                rootStyle.getPropertyValue('--color-accent-green').trim() || '#bee776',
                rootStyle.getPropertyValue('--color-accent-blue-fill').trim() || '#8fd8e0'
            ];
            var CONFETTI_PARTICLE_COUNT = 20;
            var CONFETTI_BURST_DISTANCE_PX = 70;
            var confettiLayerEl = null;

            function parseMonth(dateOnlyString) {
                var parts = dateOnlyString.split('-');
                return { year: parseInt(parts[0], 10), month: parseInt(parts[1], 10) };
            }

            function pad(n) {
                return n < 10 ? '0' + n : '' + n;
            }

            function addMonths(m, delta) {
                var total = (m.year * 12 + (m.month - 1)) + delta;
                var year = Math.floor(total / 12);
                var month = (total % 12) + 1;
                return { year: year, month: month };
            }

            function monthDiff(a, b) {
                return (a.year * 12 + a.month) - (b.year * 12 + b.month);
            }

            function daysInMonth(m) {
                return new Date(m.year, m.month, 0).getDate();
            }

            function firstWeekday(m) {
                return new Date(m.year, m.month - 1, 1).getDay();
            }

            function dateKey(m, day) {
                return m.year + '-' + pad(m.month) + '-' + pad(day);
            }

            function colorFor(participantId) {
                var participant = participantsById[participantId];
                return participant ? participant.color : 'cccccc';
            }

            function formatDateLabel(key) {
                return WWBestBets.formatDateLabel(key);
            }

            function renderCalendar() {
                monthLabelEl.innerHTML = '';
                monthLabelEl.appendChild(document.createTextNode(MONTH_NAMES[viewMonth.month - 1] + ' '));
                var yearEl = document.createElement('span');
                yearEl.className = 'ww-calendar-month-year';
                yearEl.textContent = viewMonth.year;
                monthLabelEl.appendChild(yearEl);

                prevButton.disabled = monthDiff(viewMonth, windowStart) <= 0;
                nextButton.disabled = monthDiff(viewMonth, windowEnd) >= 0;

                gridEl.innerHTML = '';

                // Leading days from the previous month and trailing days from the next fill out
                // the grid to full weeks — a smoother transition between months (no gap before the
                // 1st or after the last day) and no dead space in the final row. They're rendered
                // as full, clickable cells (just dimmed) so a date can be toggled without first
                // paging to the month it belongs to.
                var prevMonth = addMonths(viewMonth, -1);
                var nextMonth = addMonths(viewMonth, 1);
                var prevMonthDays = daysInMonth(prevMonth);
                var currentMonthDays = daysInMonth(viewMonth);

                var leadingCount = firstWeekday(viewMonth);
                for (var i = 0; i < leadingCount; i++) {
                    var leadingDay = prevMonthDays - leadingCount + 1 + i;
                    gridEl.appendChild(buildCell(prevMonth, leadingDay, true));
                }

                for (var day = 1; day <= currentMonthDays; day++) {
                    gridEl.appendChild(buildCell(viewMonth, day, false));
                }

                var cellsSoFar = leadingCount + currentMonthDays;
                var trailingCount = (7 - (cellsSoFar % 7)) % 7;
                for (var trailingDay = 1; trailingDay <= trailingCount; trailingDay++) {
                    gridEl.appendChild(buildCell(nextMonth, trailingDay, true));
                }
            }

            function buildCell(month, day, isAdjacent) {
                var key = dateKey(month, day);

                var cell = document.createElement('button');
                cell.type = 'button';
                cell.className = 'ww-calendar-cell' + (isAdjacent ? ' ww-calendar-cell-adjacent' : '');
                cell.dataset.date = key;
                cell.setAttribute('role', 'gridcell');
                // Base accessible label; updateCellCompletion below appends "— Great candidate!"
                // itself as the pick state changes. Final status is folded in here instead, since
                // (unlike completion) it never changes without a full-page reload. Both popups are
                // aria-hidden (purely visual hover/focus tooltips), so this is the only place a
                // screen reader user learns either fact.
                cell.dataset.baseLabel = formatDateLabel(key) + (finalDateKeys[key] ? ' — Save the date!' : '');
                cell.setAttribute('aria-label', cell.dataset.baseLabel);
                cell.addEventListener('click', function () {
                    toggleDate(key, cell);
                });

                var numberEl = document.createElement('span');
                numberEl.className = 'ww-calendar-cell-number';
                numberEl.textContent = day;
                cell.appendChild(numberEl);

                if (finalDateKeys[key]) {
                    cell.classList.add('ww-calendar-cell-final');

                    var tooltipEl = document.createElement('span');
                    tooltipEl.className = 'ww-calendar-cell-final-tooltip';
                    tooltipEl.setAttribute('aria-hidden', 'true');
                    tooltipEl.textContent = 'Save the date!';
                    cell.appendChild(tooltipEl);

                    // The emoji marker lives on final dates now (not "everyone's in" dates — see
                    // updateCellCompletion below), and final status can't change without a
                    // full-page reload, so it's set once here rather than added/removed per toggle.
                    var emojiEl = document.createElement('span');
                    emojiEl.className = 'ww-calendar-cell-emoji';
                    emojiEl.setAttribute('aria-hidden', 'true');
                    emojiEl.textContent = eventEmoji;
                    cell.appendChild(emojiEl);
                }

                applyWedges(cell, datesByKey[key] || []);
                updateCellCompletion(cell, datesByKey[key] || []);

                return cell;
            }

            // True once every participant in the event has picked this date.
            function isDateComplete(participantIds) {
                return calendar.participants.length > 0 && participantIds.length === calendar.participants.length;
            }

            // Toggles the thicker gold "everyone's in" border plus its "Great candidate!" popup
            // and accessible-label suffix. Called on every render (initial paint, month
            // navigation, and after each toggle) so it always matches the date's current pick
            // state — not just the moment it was first completed (see celebrateDate for that
            // one-off pop+confetti animation).
            function updateCellCompletion(cell, participantIds) {
                var complete = isDateComplete(participantIds);
                cell.classList.toggle('ww-calendar-cell-complete', complete);
                cell.setAttribute('aria-label', cell.dataset.baseLabel + (complete ? ' — Great candidate!' : ''));

                var existingTooltip = cell.querySelector('.ww-calendar-cell-complete-tooltip');
                if (complete && !existingTooltip) {
                    var tooltipEl = document.createElement('span');
                    tooltipEl.className = 'ww-calendar-cell-complete-tooltip';
                    tooltipEl.setAttribute('aria-hidden', 'true');
                    tooltipEl.textContent = 'Great candidate!';
                    cell.appendChild(tooltipEl);
                } else if (!complete && existingTooltip) {
                    existingTooltip.remove();
                }
            }

            function getConfettiLayer() {
                if (!confettiLayerEl) {
                    confettiLayerEl = document.createElement('div');
                    confettiLayerEl.className = 'ww-calendar-confetti-layer';
                    confettiLayerEl.setAttribute('aria-hidden', 'true');
                    document.body.appendChild(confettiLayerEl);
                }
                return confettiLayerEl;
            }

            // One confetti flake, fired outward (and slightly upward) from (originX, originY) —
            // viewport coordinates, since the layer it's appended to is position: fixed.
            function spawnConfettiPiece(originX, originY) {
                var layer = getConfettiLayer();

                var angle = Math.random() * Math.PI * 2;
                var distance = CONFETTI_BURST_DISTANCE_PX * (0.5 + Math.random() * 0.7);
                var dx = Math.cos(angle) * distance;
                var dy = Math.sin(angle) * distance - 30;

                var piece = document.createElement('div');
                piece.className = 'ww-calendar-confetti-piece';
                piece.style.left = originX + 'px';
                piece.style.top = originY + 'px';
                piece.style.backgroundColor = CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)];

                var flakeWidth = 4 + Math.round(Math.random() * 4);
                var flakeHeight = Math.round(flakeWidth * (0.6 + Math.random() * 0.8));
                piece.style.width = flakeWidth + 'px';
                piece.style.height = flakeHeight + 'px';

                piece.style.setProperty('--confetti-dx', dx.toFixed(0) + 'px');
                piece.style.setProperty('--confetti-dy', dy.toFixed(0) + 'px');
                var spin = (360 + Math.random() * 540) * (Math.random() < 0.5 ? -1 : 1);
                piece.style.setProperty('--confetti-rot', spin.toFixed(0) + 'deg');

                piece.addEventListener('animationend', function () {
                    piece.remove();
                });
                layer.appendChild(piece);

                // Reduced-motion: site.css skips the animation entirely, so the piece would
                // otherwise sit at full opacity forever with no animationend to clean it up.
                if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    piece.remove();
                }
            }

            // Plays once, the moment a date flips from "not everyone's in" to "everyone's in" —
            // a confetti burst from the cell's own position plus a bouncy pop on the cell itself
            // (site.css's .ww-calendar-cell-celebrating), so a plain cell and a final date that
            // happens to complete at the same moment celebrate identically. A final date's
            // (already permanent) emoji marker gets its own extra pop layered on top — see the
            // adjacent keyframe in site.css.
            function celebrateDate(cell) {
                var rect = cell.getBoundingClientRect();
                var originX = rect.left + rect.width / 2;
                var originY = rect.top + rect.height / 2;

                for (var i = 0; i < CONFETTI_PARTICLE_COUNT; i++) {
                    spawnConfettiPiece(originX, originY);
                }

                cell.classList.add('ww-calendar-cell-celebrating');
                window.setTimeout(function () {
                    cell.classList.remove('ww-calendar-cell-celebrating');
                }, 700);
            }

            function applyWedges(cell, participantIds) {
                if (participantIds.length === 0) {
                    cell.style.background = '';
                } else if (participantIds.length === 1) {
                    cell.style.background = '#' + colorFor(participantIds[0]);
                } else {
                    var slice = 100 / participantIds.length;
                    var stops = participantIds.map(function (id, index) {
                        var start = Math.round(index * slice);
                        var end = Math.round((index + 1) * slice);
                        return '#' + colorFor(id) + ' ' + start + '% ' + end + '%';
                    });
                    // A horizontal linear gradient with hard stops — vertical bands stacked left
                    // to right. Tried a vertical version (horizontal bands), a radial gradient
                    // (concentric rings), and a conic gradient with feathered edges (pie wedges,
                    // blended borders) first; this read best.
                    cell.style.background = 'linear-gradient(90deg, ' + stops.join(', ') + ')';
                }

                cell.classList.toggle('ww-calendar-cell-picked', participantIds.indexOf(calendar.currentParticipantId) !== -1);
            }

            function toggleDate(key, cell) {
                if (cell.disabled) {
                    return;
                }
                cell.disabled = true;

                var body = new URLSearchParams();
                body.set('date', key);
                body.set('__RequestVerificationToken', tokenInput ? tokenInput.value : '');

                fetch('/event/' + code + '/availability', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('Availability toggle failed');
                        }
                        return response.json();
                    })
                    .then(function (data) {
                        var wasComplete = isDateComplete(datesByKey[data.date] || []);

                        if (data.participantIds.length === 0) {
                            delete datesByKey[data.date];
                        } else {
                            datesByKey[data.date] = data.participantIds;
                        }
                        applyWedges(cell, data.participantIds);
                        updateCellCompletion(cell, data.participantIds);

                        if (!wasComplete && isDateComplete(data.participantIds)) {
                            celebrateDate(cell);
                        }

                        renderBestBets();
                        renderStatus();
                        renderFinalDates();
                    })
                    .catch(function () {
                        // No dedicated error UI for this pass — the cell simply stays in its
                        // last-known state and the click can be retried.
                    })
                    .finally(function () {
                        cell.disabled = false;
                    });
            }

            function renderLegend() {
                legendEl.innerHTML = '';
                calendar.participants.forEach(function (p) {
                    var item = document.createElement('div');
                    item.className = 'ww-calendar-legend-item';

                    var swatch = document.createElement('span');
                    swatch.className = 'ww-calendar-legend-swatch';
                    swatch.style.backgroundColor = '#' + p.color;
                    item.appendChild(swatch);

                    var name = document.createElement('span');
                    name.textContent = p.displayName;
                    item.appendChild(name);

                    legendEl.appendChild(item);
                });
            }

            function renderBestBets() {
                if (!bestBetsEl) {
                    return;
                }
                WWBestBets.renderBestBetsList(bestBetsEl, datesByKey, participantsById, calendar.participants.length);
            }

            function renderFinalDates() {
                if (!finalDatesEl) {
                    return;
                }
                WWBestBets.renderFinalDatesList(finalDatesEl, calendar.finalDates, datesByKey, participantsById, calendar.participants.length);
            }

            function renderStatus() {
                if (!statusEl) {
                    return;
                }

                var pickedParticipantIds = {};
                Object.keys(datesByKey).forEach(function (key) {
                    datesByKey[key].forEach(function (id) {
                        pickedParticipantIds[id] = true;
                    });
                });

                var totalParticipants = calendar.participants.length;
                var pickedCount = Object.keys(pickedParticipantIds).length;
                var allPicked = totalParticipants > 0 && pickedCount >= totalParticipants;

                statusEl.innerHTML = '';

                var heading = document.createElement('p');
                heading.className = 'ww-status-heading mb-1';
                heading.textContent = allPicked ? "Everyone's in." : (pickedCount + '/' + totalParticipants + ' have picked');
                statusEl.appendChild(heading);

                var subheading = document.createElement('p');
                subheading.className = 'ww-status-subheading font-display text-muted mb-3';
                subheading.textContent = allPicked
                    ? 'The group has picked their dates. Times to make it official.'
                    : 'Mark your availability, then choose the final date.';
                statusEl.appendChild(subheading);

                var button = document.createElement('a');
                button.className = 'btn ww-status-button';
                button.href = '/event/' + code + '/finalize';
                button.textContent = 'Choose the final date';
                statusEl.appendChild(button);
            }

            prevButton.addEventListener('click', function () {
                if (prevButton.disabled) {
                    return;
                }
                viewMonth = addMonths(viewMonth, -1);
                renderCalendar();
            });

            nextButton.addEventListener('click', function () {
                if (nextButton.disabled) {
                    return;
                }
                viewMonth = addMonths(viewMonth, 1);
                renderCalendar();
            });

            renderCalendar();
            renderLegend();
            renderBestBets();
            renderStatus();
            renderFinalDates();
        })();
    </script>
}
